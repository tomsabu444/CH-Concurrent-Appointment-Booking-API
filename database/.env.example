# ==============================================================================
# Microsoft SQL Server (MSSQL 2022) Environment Configuration
# ==============================================================================
ACCEPT_EULA=Y
MSSQL_PID=Developer

# System Administrator (SA) Credentials
MSSQL_SA_PASSWORD=YourStrongPassword123!

# Default Database Name
MSSQL_DB=CaritasHospitalDB

# SQL Server internal listening port. Compose publishes host port 1433 in development.
MSSQL_TCP_PORT=1433
