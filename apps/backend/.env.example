# ==========================================
# Backend API Environment Configuration
# ==========================================
NODE_ENV=development
# Node listening port. Docker publishes the API on fixed host port 3000.
PORT=3000

# Microsoft SQL Server Connection
DB_SERVER=sqlserver
# Local database connection port. Docker derives this from MSSQL_TCP_PORT.
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrongPassword123!
DB_NAME=CaritasHospitalDB
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
