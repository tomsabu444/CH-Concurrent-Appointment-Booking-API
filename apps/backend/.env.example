# ==========================================
# Backend API Environment Configuration
# ==========================================
NODE_ENV=development
# Node listening port. Docker publishes the API on fixed host port 3000.
PORT=3000
# Logging verbosity: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Microsoft SQL Server Connection (REQUIRED)
DB_SERVER=sqlserver
# Local database connection port. Docker derives this from MSSQL_TCP_PORT. (REQUIRED)
DB_PORT=1433
# Database Authentication Credentials (REQUIRED)
DB_USER=sa
DB_PASSWORD=YourStrongPassword123!
# Database Name (REQUIRED)
DB_NAME=CaritasHospitalDB

# Database TLS / SSL Options
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
